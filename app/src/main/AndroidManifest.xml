<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Only asked for when you start hands-free mode: its controls on the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The outbox's job (notes not at the chief yet) stays scheduled across restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <application android:name=".App" android:label="@string/app_name" android:theme="@style/AppTheme" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true" android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules" android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <!-- bb Connect sign-in: the browser comes back to talkrouter://oauth/callback. -->
        <activity android:name=".BbSignInActivity" android:exported="true" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="app.driftdictation.signin">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="talkrouter" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity android:name=".AttachActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="app.driftdictation.attach" android:theme="@style/AttachTheme" />
        <activity android:name=".RecordActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="app.driftdictation.record" android:theme="@style/RecordTheme" />
        <service android:name=".DictationTile" android:label="Dictate &amp; Delegate" android:icon="@drawable/ic_drift"
            android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <!-- Insert at the cursor and the volume-key start; asks for no accessibility events. -->
        <service android:name=".TalkAccessibility" android:label="@string/app_name" android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
        <service android:name=".DictationService" android:exported="false" android:foregroundServiceType="specialUse|microphone">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started dictation: keeps the floating stop control and the upload of the recording alive after the user taps stop; microphone type only while recording" />
        </service>
        <!-- Hands-free mode: listens, sends to the chief and reads its replies aloud until you end it. -->
        <service android:name=".HandsFreeService" android:exported="false" android:foregroundServiceType="microphone|mediaPlayback" />
        <!-- In-app updates: what the installer says about an update the app handed it. -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <!-- Sends notes that didn't reach the chief again, and the failure report, once there's a network. -->
        <service android:name=".Outbox$Job" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
